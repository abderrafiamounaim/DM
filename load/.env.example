# Target Salesforce org credentials — used by load_records.py

# Option A: username + password + security token
SF_USERNAME=your.email@domain.com
SF_PASSWORD=yourpassword
SF_SECURITY_TOKEN=yourtoken
SF_DOMAIN=login              # "test" for a sandbox, "login" for production,
                              # or a My Domain (e.g. mycompany--uat.sandbox)

# Option B: session-based auth (SSO/OAuth token, e.g. from Salesforce Inspector)
# Takes priority over Option A if both are set.
# SF_SESSION_ID=
# SF_INSTANCE_URL=
