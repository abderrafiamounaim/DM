# SOURCE Salesforce org credentials — the org data is migrated FROM.
SF_SOURCE_USERNAME=your.email@domain.com
SF_SOURCE_PASSWORD=yourpassword
SF_SOURCE_SECURITY_TOKEN=yourtoken
SF_SOURCE_DOMAIN=login       # "test" for a sandbox, "login" for production

# PostgreSQL staging database connection string
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/migration_staging
