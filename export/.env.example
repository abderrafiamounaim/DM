# SOURCE Salesforce org credentials — used by export.py for ad hoc SOQL pulls
# (reporting / QA / one-off extracts, distinct from the extract/ pipeline).

SF_USERNAME=your.email@domain.com
SF_PASSWORD=yourpassword
SF_SECURITY_TOKEN=yourtoken
SF_DOMAIN=login

# Or session-based auth:
# SF_SESSION_ID=
# SF_INSTANCE_URL=
